<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">

        <record id="config_sale_order" model="consultive.cancel.model.config">
            <field name="model_id" ref="sale.model_sale_order"/>
            <field name="label">Sale Order</field>
            <field name="cancel_method">action_cancel</field>
            <field name="sequence">10</field>
        </record>

        <record id="config_purchase_order" model="consultive.cancel.model.config">
            <field name="model_id" ref="purchase.model_purchase_order"/>
            <field name="label">Purchase Order</field>
            <field name="cancel_method">button_cancel</field>
            <field name="sequence">20</field>
        </record>

        <record id="config_account_move" model="consultive.cancel.model.config">
            <field name="model_id" ref="account.model_account_move"/>
            <field name="label">Invoice / Bill</field>
            <field name="cancel_method">button_cancel</field>
            <field name="sequence">30</field>
        </record>

        <record id="config_stock_picking" model="consultive.cancel.model.config">
            <field name="model_id" ref="stock.model_stock_picking"/>
            <field name="label">Transfer</field>
            <field name="cancel_method">action_cancel</field>
            <field name="sequence">40</field>
        </record>

    </data>
</odoo>
