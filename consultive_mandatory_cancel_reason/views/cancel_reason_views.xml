<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <!--
        consultive_mandatory_cancel_reason / views / cancel_reason_views.xml
        List view, form view, window action, and Settings menu for
        consultive.cancel.reason.
    -->

    <!-- List view -->
    <record id="view_cancel_reason_list" model="ir.ui.view">
        <field name="name">consultive.cancel.reason.list</field>
        <field name="model">consultive.cancel.reason</field>
        <field name="arch" type="xml">
            <list string="Cancellation Reasons">
                <field name="sequence" widget="handle"/>
                <field name="name"/>
                <field name="active" widget="boolean_toggle"/>
            </list>
        </field>
    </record>

    <!-- Form view -->
    <record id="view_cancel_reason_form" model="ir.ui.view">
        <field name="name">consultive.cancel.reason.form</field>
        <field name="model">consultive.cancel.reason</field>
        <field name="arch" type="xml">
            <form string="Cancellation Reason">
                <sheet>
                    <group>
                        <field name="name"/>
                        <field name="sequence"/>
                        <field name="active"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <!-- Window action -->
    <record id="action_cancel_reason" model="ir.actions.act_window">
        <field name="name">Cancellation Reasons</field>
        <field name="res_model">consultive.cancel.reason</field>
        <field name="view_mode">list,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                No cancellation reasons yet.
            </p>
            <p>
                Create the reasons users must choose from when cancelling
                orders, invoices, or transfers.
            </p>
        </field>
    </record>

    <!-- Menu: Settings > Technical > Cancellation > … -->
    <menuitem
        id="menu_cancel_reason_root"
        name="Cancellation"
        parent="base.menu_administration"
        groups="base.group_system"
        sequence="202"
    />
    <menuitem
        id="menu_cancel_reason"
        name="Cancellation Reasons"
        parent="menu_cancel_reason_root"
        action="action_cancel_reason"
        groups="base.group_system"
        sequence="10"
    />

</odoo>
