<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="purchase_order_form_inherit_moq" model="ir.ui.view">
        <field name="name">purchase.order.form.inherit.moq</field>
        <field name="model">purchase.order</field>
        <field name="inherit_id" ref="purchase.purchase_order_form"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='order_line']//field[@name='product_qty']" position="after">
                <field name="vendor_moq" optional="show" readonly="1"/>
            </xpath>
        </field>
    </record>

</odoo>
