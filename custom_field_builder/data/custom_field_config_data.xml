<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">
        <!-- Default Configuration Record -->
        <record id="default_custom_field_config" model="custom.field.config">
            <field name="name">Custom Field Settings</field>
            <field name="default_section_label">Additional Fields</field>
            <field name="enable_field_editor" eval="False"/>
        </record>
    </data>
    
    <!-- Ensure Field Editor menu is hidden by default -->
    <function model="ir.ui.menu" name="write">
        <value eval="[ref('menu_field_editor')]"/>
        <value eval="{'active': False}"/>
    </function>
</odoo>
