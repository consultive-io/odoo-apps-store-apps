<?xml version="1.0" encoding="utf-8"?>
<odoo>
    
    <!-- Configuration Form View -->
    <record id="view_custom_field_config_form" model="ir.ui.view">
        <field name="name">custom.field.config.form</field>
        <field name="model">custom.field.config</field>
        <field name="arch" type="xml">
            <form string="Custom Field Configuration">
                <sheet>
                    <div class="oe_title">
                        <h1>
                            <field name="name" readonly="1" class="oe_inline"/>
                        </h1>
                    </div>
                    <group>
                        <group string="Form View Settings">
                            <field name="default_section_label" placeholder="e.g. Additional Fields"/>
                        </group>
                        <group string="Features">
                            <field name="enable_field_editor"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Information" name="info">
                            <group>
                                <group string="Section Label">
                                    <p class="text-muted">
                                        <strong>Default Section Label:</strong><br/>
                                        This label will be used as the section title for all custom fields in form views.
                                    </p>
                                    <p class="text-warning">
                                        <i class="fa fa-warning"/> After changing this setting, you need to click 
                                        <strong>Update Field</strong> on existing custom fields for the change to take effect.
                                    </p>
                                </group>
                                <group string="Field Editor">
                                    <p class="text-muted">
                                        <strong>Enable Field Editor:</strong><br/>
                                        Allows you to modify attributes of existing model fields through a visual interface.
                                    </p>
                                    <div class="alert alert-warning" role="alert">
                                        <h4 class="alert-heading"><i class="fa fa-exclamation-triangle"/> Warning</h4>
                                        <p>
                                            Enabling the Field Editor allows modification of system fields. 
                                            This feature should only be used by experienced users who understand:
                                        </p>
                                        <ul>
                                            <li>Modifying system fields can affect module functionality</li>
                                            <li>Changes may be overwritten during module updates</li>
                                            <li>Only safe attributes (labels, help text, conditions) should be modified</li>
                                        </ul>
                                        <p class="mb-0">
                                            <strong>Recommended:</strong> Test changes in a development environment first.
                                        </p>
                                    </div>
                                </group>
                            </group>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>
    
    <!-- Action -->
    <record id="action_custom_field_config" model="ir.actions.act_window">
        <field name="name">Settings</field>
        <field name="res_model">custom.field.config</field>
        <field name="view_mode">form</field>
        <field name="res_id" eval="ref('default_custom_field_config')"/>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Configure Custom Field Builder
            </p>
            <p>
                Customize how custom fields appear in your forms.
            </p>
        </field>
    </record>
    
</odoo>
